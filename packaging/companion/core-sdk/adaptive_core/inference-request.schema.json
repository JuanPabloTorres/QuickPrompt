{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Requests",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 90,
          "maximum": 180,
          "minimum": 1,
          "title": "Timeoutseconds",
          "type": "integer"
        },
        "contextTokens": {
          "default": 12288,
          "maximum": 32768,
          "minimum": 1024,
          "title": "Contexttokens",
          "type": "integer"
        },
        "outputTokens": {
          "default": 2600,
          "maximum": 6000,
          "minimum": 1,
          "title": "Outputtokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "thinking": {
          "default": false,
          "title": "Thinking",
          "type": "boolean"
        },
        "topP": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topp"
        },
        "topK": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topk"
        },
        "minP": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minp"
        },
        "seed": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 64000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "adaptive-inference/1",
      "title": "Version",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[a-fA-F0-9-]{32,36}$",
      "title": "Requestid",
      "type": "string"
    },
    "model": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "mode": {
      "enum": [
        "text",
        "structured",
        "tools"
      ],
      "title": "Mode",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "outputSchema": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outputschema"
    },
    "decoding": {
      "default": "native",
      "enum": [
        "native",
        "prompted"
      ],
      "title": "Decoding",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    }
  },
  "required": [
    "version",
    "requestId",
    "model",
    "mode",
    "messages"
  ],
  "title": "InferenceRequest",
  "type": "object"
}
