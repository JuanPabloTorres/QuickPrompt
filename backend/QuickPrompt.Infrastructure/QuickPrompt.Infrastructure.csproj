<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/QuickPrompt.Domain/QuickPrompt.Domain.csproj" />
    <ProjectReference Include="../QuickPrompt.Application/QuickPrompt.Application.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- Transitional source links: audited non-UI services only. No reference to the Blazor project. -->
    <Compile Include="../../src/QuickPrompt.Web/Infrastructure/*.cs"
             Exclude="../../src/QuickPrompt.Web/Infrastructure/WebPromptTransfer.cs;../../src/QuickPrompt.Web/Infrastructure/PanelSession.cs"
             Link="Legacy/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
