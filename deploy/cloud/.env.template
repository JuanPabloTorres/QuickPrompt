# Backend-only inventory, not a credential file. Configure real values privately; never expose them through VITE_*.
# Frontend/proxy configuration belongs to deploy/vercel/README.md. No deployed URL is implied by these placeholders.
ASPNETCORE_ENVIRONMENT=Production
QuickPrompt__Hosting__Mode=Public
QuickPrompt__Accounts__Origin=https://PUBLIC_WEB_HOST
QuickPrompt__Hosting__ListenUrl=http://0.0.0.0:10000
QuickPrompt__Hosting__IngressProfile=OriginProxy
QuickPrompt__Hosting__IngressOrigin=https://PHYSICAL_BACKEND_HOST
# Exactly 64 private hexadecimal characters; identical to Vercel's server-side ORIGIN_SECRET.
# The proxy must overwrite X-QP-Origin-Secret; do not trust a client-supplied value.
QuickPrompt__Hosting__OriginSecret=PRIVATE_64_HEX_SECRET
# OriginProxy forbids TrustedProxies/TrustedNetworks and automatic forwarded-header middleware.
# TrustedProxy remains an alternative for separately verified infrastructure, not an extra setting for this profile.
QUICKPROMPT_KEY_RING_CERTIFICATE_BASE64=PRIVATE_BASE64_PFX
QuickPrompt__Hosting__KeyRingCertificatePassword=PRIVATE_PFX_PASSWORD
# Optional rotation: at most four decryption-only predecessors, indexed 0..3. Retain until their payloads are retired.
# QUICKPROMPT_KEY_RING_PREVIOUS_CERTIFICATE_0_BASE64=PRIVATE_PREVIOUS_PFX
# QuickPrompt__Hosting__PreviousKeyRingCertificates__0__Password=PRIVATE_PREVIOUS_PFX_PASSWORD
# Or mount physical private files and use QuickPrompt__Hosting__PreviousKeyRingCertificates__0__Path.
QuickPrompt__Delegation__Enabled=true
QuickPrompt__Delegation__KeyDirectory=/etc/secrets
# These two stable PEM secret files belong to this origin, not to a local/dev library:
# /etc/secrets/signing.pem
# /etc/secrets/encryption.pem
ConnectionStrings__Accounts=Host=PRIVATE_PG_HOST;Port=5432;Database=APP_DB;Username=quickprompt_app;Password=PRIVATE;SSL Mode=VerifyFull
ConnectionStrings__Executions=Host=PRIVATE_PG_HOST;Port=5432;Database=APP_DB;Username=quickprompt_execution;Password=PRIVATE;SSL Mode=VerifyFull
# Register the actual callback of the chosen MCP client. An example URI is not a working integration.
QuickPrompt__Mcp__RedirectUri=https://ACTUAL_CLIENT_CALLBACK
# Optional Google sign-in; production configuration must use this public origin's registered callback.
# QuickPrompt__Accounts__Google__ClientId=PRIVATE_CONFIGURATION
# QuickPrompt__Accounts__Google__ClientSecret=PRIVATE_CONFIGURATION
# Optional transactional mail. Verify the sender and store the API key privately; no provider call happens at startup.
# QuickPrompt__Accounts__Brevo__ApiKey=PRIVATE_CONFIGURATION
# QuickPrompt__Accounts__Brevo__SenderEmail=VERIFIED_SENDER_EMAIL
# QuickPrompt__Accounts__Brevo__SenderName=QuickPrompt
# Optional alternative, never an automatic fallback. Choose ONE provider; remove the other provider's three keys.
# QuickPrompt__Accounts__MailProvider=Smtp2Go
# QuickPrompt__Accounts__Smtp2Go__ApiKey=PRIVATE_CONFIGURATION
# QuickPrompt__Accounts__Smtp2Go__SenderEmail=VERIFIED_SENDER_EMAIL
# QuickPrompt__Accounts__Smtp2Go__SenderName=QuickPrompt
