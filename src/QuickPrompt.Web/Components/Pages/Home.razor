@page "/"
@using QuickPrompt.Local
@using QuickPrompt.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms
@using QuickPrompt.Web.Infrastructure
@implements IDisposable
@using QuickPrompt.Web.Components.Shared
<PageTitle>QuickPrompt · @T("Tu biblioteca de ideas", "Your library of ideas")</PageTitle>
<div class="shell simple-shell font-sans antialiased" data-theme="@prefs.Theme" data-copy-count="@copyCount">
<a class="skip" href="#main">@T("Saltar al contenido", "Skip to content")</a>
<main id="main" tabindex="-1">
<header class="simple-header">
<a href="/" class="brand" @onclick='()=>NavigateFromUi("library")' @onclick:preventDefault><img class="logo" src="branding/quickprompt_official.png" width="43" height="43" alt="" /><span>QuickPrompt</span></a>
<div class="global-search"><label class="sr-only" for="search">@T("Buscar plantillas", "Search templates")</label><input id="search" type="search" placeholder="@T("Buscar un prompt…", "Find a prompt…")" @bind="search" @bind:event="oninput" @bind:after="SearchLibrary" maxlength="200" /><kbd aria-hidden="true">Ctrl K</kbd></div>
<button class="primary" @onclick="NewTemplate" aria-label="@T("Nueva plantilla", "New template")"><AppIcon Name="plus" /><span class="action-label">@T("Nueva plantilla", "New template")</span></button>
<button class="settings-trigger" @onclick='()=>NavigateFromUi("settings")' aria-label="@T("Configuración", "Settings")"><AppIcon Name="settings" /></button>
</header>
<div class="page-heading"><h1>@ViewTitle</h1><button class="assist-trigger" @onclick="OpenAssist"><AppIcon Name="sparkles" />Quick Assist</button>@if(view is not("library" or "favorites" or "recent")){<button @onclick='()=>NavigateFromUi("library")'>@T("Volver a la biblioteca","Back to library")</button>}</div>
<Toast Message="@message" Error="error" />
@if(view is "library" or "favorites" or "recent" or "archive"){
@if(showGroupManager){<section class="context-manager" aria-label="@T("Organización de grupos","Group organization")"><button @onclick="()=>showGroupManager=false">@T("Cerrar organización","Close organization")</button><GroupLibrary Language="@prefs.Language" Changed="OrganizationChanged" /></section>}
@if(showInstructionManager){<section class="context-manager" aria-label="@T("Instrucciones guardadas","Saved instructions")"><button @onclick="()=>showInstructionManager=false">@T("Cerrar instrucciones","Close instructions")</button><InstructionLibrary Language="@prefs.Language" Changed="OrganizationChanged" UseInstruction="UseInstruction" /></section>}
@if(!showGroupManager && !showInstructionManager){<div class="workspace @(mobileDetail?"mobile-detail":"") @(catalog.Total==0&&!editing?"empty-workspace":"")"><section class="library" aria-label="@T("Biblioteca", "Library")">
<div class="library-tools"><nav class="quick-filters" aria-label="@T("Filtrar biblioteca","Filter library")"><button aria-pressed="@(view=="library"?"true":"false")" @onclick='()=>NavigateFromUi("library")'>@T("Todos","All")</button><button aria-pressed="@(view=="favorites"?"true":"false")" @onclick='()=>NavigateFromUi("favorites")'>@T("Favoritos","Favorites")</button><button aria-pressed="@(view=="recent"?"true":"false")" @onclick='()=>NavigateFromUi("recent")'>@T("Recientes","Recent")</button></nav>
<details class="compact-filters"><summary>@T("Filtros","Filters") @if(category!=""||groupFilter!=""){<span aria-label="@T("Filtros activos","Active filters")">•</span>}</summary>
<div class="filters"><div><label for="category-filter">@T("Categoría", "Category")</label><select id="category-filter" @bind="category" @bind:after="ResetPage"><option value="">@T("Todas las categorías", "All categories")</option>@foreach(var c in Enum.GetNames<PromptCategory>()){<option>@c</option>}</select></div><div><label for="sort-filter">@T("Orden", "Sort")</label><select id="sort-filter" @bind="sort" @bind:after="ResetPage"><option value="updated">@T("Actualizadas", "Updated")</option><option value="recent">@T("Uso reciente", "Recently used")</option><option value="usage">@T("Más usadas", "Most used")</option><option value="title">@T("Título", "Title")</option></select></div></div>
<label for="group-filter">@T("Grupo", "Group")</label><select id="group-filter" @bind="groupFilter" @bind:after="ResetPage"><option value="">@T("Todos los grupos", "All groups")</option><option value="ungrouped">@T("Sin grupo", "Ungrouped")</option>@foreach(var g in groups){<option value="@g.Group.Id">@g.Group.Name (@g.Templates)</option>}</select>
<label for="new-filter-group">@T("Crear grupo","Create group")</label><div class="inline-form"><input id="new-filter-group" @bind="newGroupName" maxlength="80" /><button @onclick="CreateFilterGroup">@T("Crear grupo","Create group")</button></div><button @onclick="()=>showGroupManager=!showGroupManager">@T("Gestionar grupos","Manage groups")</button>
<details class="bulk-actions"><summary>@T("Organizar selección", "Organize selection") (@bulkIds.Count)</summary><label class="check"><input type="checkbox" @bind="bulkMode" />@T("Seleccionar varios prompts","Select several prompts")</label><label for="batch-group">@T("Asignar al grupo", "Assign to group")</label><select id="batch-group" @bind="batchGroup"><option value="">@T("Selecciona un grupo", "Choose a group")</option>@foreach(var g in groups){<option value="@g.Group.Id">@g.Group.Name</option>}</select><div class="action-row"><button disabled="@(bulkIds.Count==0 || batchGroup=="")" @onclick="()=>AssignBatch(true)">@T("Agregar selección", "Add selection")</button><button disabled="@(bulkIds.Count==0 || batchGroup=="")" @onclick="()=>AssignBatch(false)">@T("Quitar selección", "Remove selection")</button></div></details>
</details></div>
<div class="section-caption"><span>@catalog.Total @T("plantillas", "templates")</span><span>@T("A tu alcance", "At your fingertips")</span></div>
@foreach(var item in Filtered){<PromptCard @key="item.Id" Item="item" Selected="@(selected?.Id==item.Id)" Language="@prefs.Language" OnSelect="SelectFromLibrary" OnFavorite="Favorite" SelectionEnabled="bulkMode" Checked="@bulkIds.Contains(item.Id)" OnCheck="ToggleBulk" />}
@if(!Filtered.Any()){<div class="empty"><span aria-hidden="true"><AppIcon Name="braces" /></span><h2>@T("Haz espacio para tu próxima idea", "Make room for your next idea")</h2><p>@T("Crea una plantilla o prueba otra búsqueda.", "Create a template or try another search.")</p><button @onclick="NewTemplate">@T("Crear plantilla", "Create template")</button></div>}
@if(catalog.Total>12){<div class="pagination"><button disabled="@(page==0)" @onclick="()=>ChangePage(-1)">@T("Anterior", "Previous")</button><span>@(page+1)</span><button disabled="@((page+1)*12>=catalog.Total)" @onclick="()=>ChangePage(1)">@T("Siguiente", "Next")</button></div>}
</section><section class="detail" aria-label="@T("Plantilla seleccionada", "Selected template")">
<button class="back-library" @onclick="BackToList">← @T("Biblioteca","Library")</button>
@if(editing){var form=draft;<div class="prompt-editor" @key="form.Id">
<h2>@T("Tu prompt", "Your prompt")</h2>
<label for="title">@T("Título", "Title")</label><input id="title" @bind="form.Title" maxlength="160" />
<TemplateTextEditor Model="form" Language="@prefs.Language" Changed="()=>InvokeAsync(StateHasChanged)" /><p class="hint">@T("Usa <variable>. Selecciona texto para convertirlo en variable. Escapa un < literal con barra inversa.", "Use <variable>. Select text to turn it into a variable. Escape a literal < with a backslash.")</p><p class="detected-variables">@T("Variables detectadas: ","Detected variables: ")@(DraftNames.Length==0?T("ninguna","none"):string.Join(", ",DraftNames))</p><details class="editor-extra"><summary>@T("Más opciones del prompt","More prompt options")</summary><label for="description">@T("Descripción", "Description")</label><textarea id="description" @bind="form.Description" maxlength="2000" rows="2"></textarea>
<label for="draft-category">@T("Categoría", "Category")</label><select id="draft-category" @bind="form.Category">@foreach(var c in Enum.GetValues<PromptCategory>()){<option value="@c">@c</option>}</select>
<div class="tabbar"><button aria-pressed="@(!visual ? "true" : "false")" @onclick="()=>visual=false">@T("Texto", "Text")</button><button aria-pressed="@(visual ? "true" : "false")" @onclick="()=>visual=true">@T("Visual / chips", "Visual / chips")</button></div>
@if(visual){<div class="visual-preview">@foreach(var token in DraftTokens){if(token.Name is null){<span>@token.Text</span>}else{<button class="chip" @onclick="()=>FocusEditor(token.Name)">@token.Name</button>}}</div>}

<details><summary>@T("Valores por defecto (opcionales)", "Default values (optional)")</summary>@foreach(var n in DraftNames){<label>@n<input value="@form.Variables.GetValueOrDefault(n)" @onchange="e=>form.Variables[n]=e.Value?.ToString()??string.Empty" maxlength="8000" /></label>}</details>
</details>
<details class="editor-ai"><summary>@T("Ayuda de IA (opcional)","AI help (optional)")</summary><label for="editor-intent">@T("Describe el prompt que necesitas","Describe the prompt you need")</label><textarea id="editor-intent" @bind="aiContext" maxlength="8000" rows="2"></textarea><div class="action-row"><button disabled="@(busy||webTransferBusy)" @onclick='()=>Propose("create")'>@T("Proponer borrador","Propose draft")</button><button disabled="@(busy||webTransferBusy)" @onclick="ImproveDraft">@T("Mejorar con IA","Improve with AI")</button>@if(busy){<button @onclick="Stop">@T("Detener","Stop")</button>}</div></details>
<div class="action-row"><button class="primary" @onclick="()=>SaveDraftFor(form.Id)">@T("Guardar plantilla", "Save template")</button><button @onclick="CancelEdit">@T("Cancelar", "Cancel")</button></div>
</div>}else if(selected is not null){
<div class="selected-heading"><div><h2 tabindex="-1">@selected.Title</h2>@if(!string.IsNullOrWhiteSpace(selected.Description)){<p class="muted">@selected.Description</p>}</div><details class="prompt-options"><summary>@T("Opciones","Options")</summary><div class="prompt-menu"><div class="action-row compact"><button @onclick="EditSelected">@T("Editar", "Edit")</button><button @onclick="Duplicate">@T("Duplicar", "Duplicate")</button><button @onclick="ArchiveSelected">@(selected.IsActive?T("Archivar","Archive"):T("Restaurar","Restore"))</button><button class="danger-text" @onclick="DeleteSelected">@T("Eliminar","Delete")</button><button @onclick="SaveSelectedVersion">@T("Guardar como versión", "Save as version")</button><button @onclick="()=>Favorite(selected)">@(selected.IsFavorite?T("Quitar favorito","Remove favorite"):T("Guardar como favorito","Save as favorite"))</button></div><details><summary>@T("Ver plantilla","View template")</summary><div class="template-preview">@foreach(var token in TemplateCompiler.Parse(selected.Template)){if(token.Name is null){<span>@token.Text</span>}else{<span class="chip">@token.Name</span>}}</div></details><details class="template-sharing"><summary>@T("Compartir plantilla","Share template")</summary><p class="hint">@T("Comparte solo título, texto, descripción y categoría. Revisa el contenido antes de compartirlo.","Shares only title, text, description and category. Review content before sharing.")</p><div class="action-row"><button @onclick="()=>Copy(selected.Template)">@T("Copiar texto de plantilla","Copy template text")</button><button @onclick="ShareTemplateText">@T("Compartir con el navegador","Share with browser")</button><button @onclick="ShareTemplateJson">@T("Descargar plantilla JSON","Download template JSON")</button></div></details><GroupMembershipPicker @key="selected.Id" EntityId="selected.Id" Groups="groups" Language="@prefs.Language" Changed="OrganizationChanged" Manage="()=>showGroupManager=true" /><button disabled="@(busy||webTransferBusy)" @onclick="OpenAiTools">@T("Mejorar con IA","Improve with AI")</button><details><summary>@T("Historial de versiones","Version history") (@Templates.Versions(selected.Id).Length)</summary>@foreach(var version in Templates.Versions(selected.Id)){<div class="history-version"><strong>v@(version.Revision) · @version.Reason</strong><small>@version.CreatedAt.ToLocalTime().ToString("g")</small><pre>@version.Snapshot.Template</pre></div>}</details></div></details></div>
@if(selected.IsActive){var completionId=selected.Id;var completionRevision=selected.Revision;<div class="completion-form" @key="(completionId,completionRevision)">
@foreach(var name in TemplateCompiler.Names(selected.Template)){<label for="@VariableId(name)">@name</label><textarea id="@VariableId(name)" rows="2" aria-required="true" aria-invalid="@(missingVariable==name?"true":"false")" aria-describedby="@(missingVariable==name?"missing-variable":null)" @bind:get="values.GetValueOrDefault(name)" @bind:set="value=>SetValueFor(completionId,completionRevision,name,value??string.Empty)" @bind:event="oninput" maxlength="8000"></textarea>
@if(missingVariable==name){<span id="missing-variable" class="field-error" role="alert">@T("Completa este campo.","Complete this field.")</span>}
@if(prefs.RememberValues){@foreach(var previous in PreviousValues(name)){<button class="suggestion" @onclick="()=>SetValueFor(completionId,completionRevision,name,previous)">@previous</button>}}
@if(suggestions.TryGetValue(name,out var suggestion)){<button class="suggestion" @onclick="()=>SetValueFor(completionId,completionRevision,name,suggestion)">@T("IA · usar ejemplo: ", "AI · use example: ")@suggestion</button>}}
@if(reuseSnapshot){<p class="hint">@T("Texto final guardado del historial. Cambia los campos para crear una nueva variación.","Saved final text from history. Change fields to create a new variation.")</p>}<div class="reuse-actions"><button class="accent-button wide" disabled="@(busy||webTransferBusy)" data-qp-copy aria-keyshortcuts="Control+Enter Meta+Enter" title="Ctrl / Cmd + Enter" @onclick="CopyCurrent">@T("Copiar prompt","Copy prompt")</button><button disabled="@(busy||webTransferBusy)" @onclick="ShowDestinations">@T("Usar en…","Use in…")</button></div>
@if(usingPrompt){<section class="destinations" aria-label="@T("Elegir destino","Choose destination")"><div class="action-row"><button @onclick='()=>ChooseDestination("qwen")'>@T("Qwen local","Local Qwen")</button><button @onclick='()=>ChooseDestination("chatgpt")'>ChatGPT</button><button @onclick='()=>ChooseDestination("claude")'>Claude</button><button class="text-button" @onclick="CloseDestination">@T("Cerrar destinos","Close destinations")</button></div></section>}
@if(compiled is not null && (destination is "chatgpt" or "claude")){<div class="external-context"><ProviderActionMenu @key="(compiled.Id,destination)" Prompt="compiled" Language="@prefs.Language" Disabled="busy" BusyChanged="OnWebTransferBusyChanged" OnlyProvider="@(destination=="chatgpt"?ProviderId.ChatGptWeb:ProviderId.ClaudeWeb)" /></div>}
<details class="final-preview" open="@(revealPreview || TemplateCompiler.Names(selected.Template).Length==0)"><summary>@T("Vista previa","Preview")</summary><div class="preview-content">@if(compiled is not null){@if(compiled.Composition is {} used){<p class="hint" data-testid="compiled-instruction">@T("Perfil usado: ","Profile used: ")@(used.InstructionName??T("sin perfil","no profile")) @if(used.InstructionRevision is {} revision){<span> · v@(revision)</span>}</p>}<pre class="result" data-testid="compiled">@compiled.Text</pre>}else{<pre class="result" data-testid="live-preview">@PreviewText</pre>}</div></details><details class="composition-options"><summary>@T("Opciones avanzadas","Advanced options")@if(instructionId!=""||promptAdjustments!=""||prefs.GeneralInstructions!=""){<span> · @T("instrucciones activas","instructions active")</span>}</summary><button disabled="@(busy||webTransferBusy)" @onclick="()=>CompileFor(completionId,completionRevision)">@T("Generar texto final","Generate final text") →</button><label for="instruction-search">@T("Buscar perfil de instrucciones (opcional)", "Find instruction profile (optional)")</label><input id="instruction-search" type="search" @bind="instructionSearch" @bind:event="oninput" @bind:after="LoadInstructionChoices" maxlength="200" /><label for="selected-instruction">@T("Instrucción seleccionada", "Selected instruction")</label><select id="selected-instruction" value="@instructionId" @onchange="ChangeInstruction"><option value="">@T("Sin perfil de instrucciones", "No instruction profile")</option>@foreach(var p in instructionChoices){<option value="@p.Id">@p.Name · v@(p.Revision)</option>}</select>
<details><summary>@T("Ajustes y combinaciones reutilizables", "Adjustments and reusable combinations")</summary><label for="prompt-adjustments">@T("Ajustes específicos del prompt", "Prompt-specific adjustments")</label><textarea id="prompt-adjustments" rows="2" @bind:get="promptAdjustments" @bind:set="ChangeAdjustments" @bind:event="oninput" maxlength="4000"></textarea><p class="hint">@T("Prioridad: ajustes del prompt, perfil seleccionado, instrucciones generales. Revisa siempre el texto final antes de ejecutarlo.","Priority: prompt adjustments, selected profile, general instructions. Always review the final text before running.")</p><label for="combination-name">@T("Nombre de la combinación", "Combination name")</label><input id="combination-name" @bind="combinationName" maxlength="160" /><button @onclick="SaveCombination">@T("Guardar combinación", "Save combination")</button>@foreach(var c in CurrentCombinations){<div class="combination-row"><button @onclick="()=>ApplyCombination(c)">@T("Usar combinación: ","Use combination: ")@c.Name</button><button class="danger-text" aria-label="@(T("Eliminar combinación: ","Delete combination: ")+c.Name)" @onclick="()=>DeleteCombination(c.Id)">@T("Eliminar", "Delete")</button></div>}</details><button @onclick="()=>showInstructionManager=!showInstructionManager">@T("Gestionar instrucciones","Manage instructions")</button></details>
</div>}

@if(destination=="qwen"||showAiTools){
<ModelStatus Model="@prefs.Model" Language="@prefs.Language" Status="@LocalStatus" Busy="@(busy||webTransferBusy)" Checking="checkingOllama" Check="CheckOllama" />
<div class="ai-box"><div class="detail-heading"><h3>@T("Un impulso de IA", "An AI boost")</h3><span class="local-pill">LOCAL · @prefs.Model</span></div><p>@T("Propuestas que tú decides. El original siempre bajo tu control.", "Suggestions you choose. Your original stays in your control.")</p><label for="ai-context">@T("Contexto autorizado para IA (opcional)", "Authorized AI context (optional)")</label><textarea id="ai-context" rows="2" @bind="aiContext" maxlength="8000" disabled="@(busy||webTransferBusy)"></textarea>
<div class="action-row"><button disabled="@(busy||webTransferBusy)" @onclick='()=>Propose("improve")'><AppIcon Name="sparkles" /> @T("Mejorar", "Improve")</button><button disabled="@(busy||webTransferBusy)" @onclick="Suggest">@T("Sugerir valores", "Suggest values")</button><button disabled="@(busy||webTransferBusy)" @onclick="Analyze">@T("Analizar", "Analyze")</button></div><p class="hint">@T("Sugerencias inciertas del modelo sobre este contexto. No se aplican solas.", "Uncertain model suggestions based on this context. Never applied automatically.")</p>
@if(compiled is not null){<label class="check"><input type="checkbox" @bind="confirmed" />@T("Confirmo enviar este texto final al modelo local", "I confirm sending this final text to the local model")</label><button class="primary" disabled="@(busy || webTransferBusy || !confirmed)" @onclick="Execute">@T("Ejecutar localmente / Reintentar", "Run locally / Retry")</button>}
@if(busy){<div role="status" class="busy-status" data-testid="local-ai-running"><AppIcon Name="loader-circle" /><p>@T("Procesando en tu equipo…", "Processing on your device…")</p><button @onclick="Stop">@T("Detener", "Stop")</button></div>}
@if(!string.IsNullOrEmpty(response)){<pre class="result" data-testid="llm-response">@response</pre><div class="action-row"><button @onclick="()=>Copy(response)">@T("Copiar respuesta", "Copy response")</button><button disabled="@(busy || webTransferBusy || pendingExecution is null)" @onclick="SaveResponse">@T("Guardar resultado", "Save result")</button></div>}
</div>
<button @onclick="CloseLocalResult">@T("Cerrar resultado","Close result")</button>}

@if(!string.IsNullOrEmpty(analysis)){<div class="analysis"><h3>@T("Análisis determinista","Deterministic analysis")</h3><p>@analysis</p></div>}
}else{<div class="empty detail-empty"><span aria-hidden="true"><AppIcon Name="arrow-up-right" /></span><h2>@T("De idea a acción", "From idea to action")</h2><p>@T("Selecciona una plantilla, completa sus variables y hazla tuya.", "Choose a template, fill its variables and make it yours.")</p><div class="flow-label">@T("Selecciona → Completa → Copia", "Choose → Fill → Copy")</div><button @onclick="NewTemplate">@T("Crear tu primera plantilla", "Create your first template")</button></div>}
</section></div>}
}else if(view=="history"){
<section class="content-panel"><div class="action-row"><p>@T("Textos finalizados y resultados guardados en este equipo.", "Final texts and results saved on this device.")</p><button class="danger-text" @onclick="ClearHistory">@T("Borrar historial y valores", "Clear history and values")</button></div>
<details class="web-transfer-log"><summary>@T("Transferencias web (sin contenido)", "Web transfers (no content)") (@TransferHistory.Transfers().Count)</summary>@foreach(var transfer in TransferHistory.Transfers()){<article class="transfer-audit-card" data-phase="@transfer.Phase"><strong>@transfer.Provider · @TransferSummary(transfer)</strong><small>@transfer.CreatedAt.ToLocalTime().ToString("g") · @transfer.DurationMs ms</small><details><summary>@T("Datos del registro", "Audit metadata")</summary><small>@transfer.Id · @transfer.Phase · @transfer.Code</small></details></article>}</details>
@foreach(var h in Compiled.History()){<article class="history-card"><div class="detail-heading"><h2>@h.Title</h2><button class="star" aria-label="@T("Favorito final", "Favorite final")" aria-pressed="@(h.Favorite ? "true" : "false")" @onclick="()=>FinalFavorite(h)"><AppIcon Name="star" /></button></div><small>v@(h.Revision) · @h.CreatedAt.ToLocalTime().ToString("g")</small><pre>@h.Text</pre><div class="action-row"><button @onclick="()=>Copy(h.Text)">@T("Copiar prompt", "Copy prompt")</button><button @onclick="()=>Reuse(h)">@T("Reutilizar", "Reuse")</button></div>@foreach(var run in Compiled.Executions().Where(e=>e.CompiledId==h.Id)){<details><summary>@run.Model · @run.ElapsedMs.ToString("F0") ms</summary><pre>@run.Response</pre><button @onclick="()=>Copy(run.Response)">@T("Copiar respuesta", "Copy response")</button></details>}</article>}
@if(Compiled.History().Count==0){<p>@T("Aún no hay textos finalizados. Empieza desde la biblioteca.", "No final texts yet. Start from the library.")</p>}</section>
}else if(view=="settings"){
<nav class="secondary-navigation" aria-label="@T("Más herramientas","More tools")"><button @onclick='()=>NavigateFromUi("history")'>@T("Historial","History")</button><button @onclick='()=>NavigateFromUi("archive")'>@T("Archivadas","Archived")</button><button @onclick='()=>NavigateFromUi("help")'>@T("Guía e inspiración","Guide & inspiration")</button></nav>

<section class="content-panel basic-settings"><h2>@T("General","General")</h2><label for="language">@T("Idioma", "Language")</label><select id="language" value="@prefs.Language" @onchange="ChangeLanguage"><option value="es">Español</option><option value="en">English</option></select><label for="theme">@T("Tema", "Theme")</label><select id="theme" value="@prefs.Theme" @onchange="ChangeTheme"><option value="light">@T("Claro", "Light")</option><option value="dark">@T("Oscuro", "Dark")</option></select><button @onclick="ToggleTheme" aria-label="@T("Cambiar tema","Toggle theme")">@T("Alternar tema","Toggle theme")</button></section><details class="settings-advanced"><summary>@T("Configuración avanzada","Advanced settings")</summary><button @onclick='()=>NavigateFromUi("instructions")'>@T("Instrucciones guardadas","Saved instructions")</button><section class="content-panel bridge-diagnostics"><h2>@T("Privacidad y automatización","Privacy and automation")</h2><button @onclick="CheckBridge">@T("Comprobar extensión","Check extension")</button><p role="status">@bridgeDiagnostic</p><p class="hint">@T("Detectar el puente no verifica una sesión externa. ChatGPT real no está validado; Claude automatizado está bloqueado. Puedes copiar y abrir.","Detecting the bridge does not verify an external session. Real ChatGPT is not validated; Claude automation is blocked. Copy and open remains available.")</p></section><section class="content-panel general-instructions"><h2>@T("Instrucciones generales", "General instructions")</h2><label for="general-instructions">@T("Reglas generales para tus consultas (opcional)", "General rules for your queries (optional)")</label><textarea id="general-instructions" rows="3" maxlength="4000" value="@prefs.GeneralInstructions" @onchange="ChangeGeneralInstructions"></textarea><p class="hint">@T("Se incluyen al compilar. El perfil seleccionado y los ajustes específicos tienen mayor prioridad. No conceden herramientas ni permisos.","Included when compiling. The selected profile and prompt adjustments have higher priority. They do not grant tools or permissions.")</p></section>
<section class="content-panel settings"><h2>@T("Modelos y proveedores", "Models and providers")</h2><label for="model">@T("Modelo local", "Local model")</label><select id="model" value="@prefs.Model" @onchange="ChangeModel">@foreach(var m in LocalModelPolicy.Production.Names){<option>@m</option>}</select>@if(prefs.Model=="qwen2.5:7b-instruct"){<p class="hint" data-testid="model-limitation">@T("Qwen2.5 es una alternativa: en la evaluación local cometió errores factuales. Revisa sus afirmaciones antes de reutilizarlas.", "Qwen2.5 is an alternative: local evaluation found factual errors. Review its claims before reuse.")</p>}<button @onclick="CheckOllama">@T("Comprobar Ollama", "Check Ollama")</button><p>@ollamaStatus</p><label class="check"><input type="checkbox" checked="@prefs.RememberValues" @onchange="Remember" />@T("Guardar valores para sugerirlos después (opt-in)", "Save variable values for later suggestions (opt-in)")</label><p class="hint">@T("El texto final y las versiones se guardan localmente. La respuesta IA solo se guarda al pulsar Guardar resultado. Puedes borrar el historial.", "Final texts and versions are saved locally. AI responses save only with Save result. History can be deleted.")</p></section><section class="content-panel data-settings"><h2>@T("Mis datos", "My data")</h2><div class="action-row"><button @onclick="Export">@T("Exportar / respaldo JSON", "Export / JSON backup")</button><button @onclick="Integrity">@T("Verificar consistencia", "Check integrity")</button></div><label for="import-file">@T("Importar plantillas JSON o DB legada seleccionada", "Import JSON templates or selected legacy DB")</label><InputFile id="import-file" OnChange="ImportFile" accept=".json,.db3,.sqlite" /><p class="hint">@T("Importación agrega sin sobrescribir. El archivo de origen no se modifica.", "Import adds without overwriting. Source file stays untouched.")</p><label for="restore-file">@T("Restaurar respaldo JSON completo (con confirmación)", "Restore complete JSON backup (with confirmation)")</label><InputFile id="restore-file" OnChange="RestoreFile" accept=".json" /><button class="danger-text" @onclick="ClearHistory">@T("Borrar historial y valores", "Clear history and values")</button></section></details>
}else{
<section class="content-panel"><h2>@T("Una plantilla. Muchas posibilidades.", "One template. Many possibilities.")</h2><ol><li>@T("Crea o importa una plantilla con <variables>.", "Create or import a template with <variables>.")</li><li>@T("Búscala por texto o categoría y selecciónala.", "Find it by text or category and choose it.")</li><li>@T("Completa los campos y copia el prompt.", "Fill the fields and copy the prompt.")</li><li>@T("Opcional: revisa propuestas IA o ejecuta localmente con confirmación.", "Optional: review AI proposals or run locally with confirmation.")</li></ol><p>@T("Ctrl/Cmd+K abre el buscador dentro del navegador. Tab y Enter permiten navegar. Los chips del editor llevan al texto para modificar variables.", "Ctrl/Cmd+K opens the browser launcher. Use Tab and Enter to navigate. Editor chips select the variable text.")</p><p>@T("Ollama no es necesario para organizar, completar o copiar. Las transferencias externas requieren una acción y consentimiento explícitos. Aplicación local de un solo usuario; no exponer a Internet.", "Ollama is optional for organizing, completing and copying. External transfers require an explicit action and consent. Local single-user app; do not expose to the Internet.")</p><p>@T("Para crear con IA, abre Nueva plantilla y luego Ayuda de IA. Revisa el borrador antes de guardarlo.","To create with AI, open New template, then AI help. Review the draft before saving.")</p><button @onclick="NewTemplate">@T("Crear plantilla","Create template")</button></section>
}

</main></div>
<OverlayHost>
<dialog id="assist-dialog" aria-labelledby="assist-title" aria-modal="false" @onclose="AssistClosed"><h2 id="assist-title">Quick Assist</h2><p class="hint">@T("Busca, crea o mejora con una orden breve.","Find, create or improve with a short command.")</p><label for="assist-command">@T("¿Qué necesitas?","What do you need?")</label><textarea id="assist-command" @onkeydown="AssistKeyDown" rows="1" maxlength="1000" @bind="assistCommand" @bind:event="oninput" @bind:after="()=>assistPlan=null"></textarea><p class="hint">@T("Sin IA: buscar correo · favoritos · recientes · grupo Trabajo · abrir Título. Con Qwen: crear una intención, mejorar o sugerir variables.","Without AI: search email · favorites · recent · group Work · open Title. With Qwen: create an intent, improve or suggest variables.")</p><div class="action-row"><button disabled="@assistBusy" @onclick="PrepareAssist">@T("Continuar","Continue")</button>@if(assistBusy){<button @onclick="CancelAssist">@T("Detener","Stop")</button>}<button disabled="@assistBusy" @onclick="InterpretAssist">@T("Interpretar con Qwen","Interpret with Qwen")</button><button @onclick="CloseAssist">@T("Cerrar asistente","Close assistant")</button></div>@if(assistBusy){<p class="assist-progress" role="status"><AppIcon Name="loader-circle" />@T("Preparando en tu equipo… Puedes seguir usando la biblioteca.","Preparing on your device… You can keep using the library.")</p>}@if(!assistBusy && assistPlan is null){<div class="assist-results">@foreach(var match in AssistMatches){<button class="launcher-result" @onclick="()=>LaunchAssist(match)">@match.Title<AppIcon Name="arrow-up-right" /></button>}</div>}@if(assistError!=""){<p class="notice error" role="alert">@assistError</p>}@if(assistPlan is {} plan){<p>@(plan.Plan.Source=="deterministic"?T("Comando local, sin modelo.","Local command, no model."):T("Interpretación de Ollama. Verifica cada paso.","Ollama interpretation. Check each step."))</p><ol>@foreach(var step in plan.Steps){<li>@AssistLabel(step.Step.Action) @step.Step.Argument @if(step.TemplateId is {} id){<strong> · @Templates.Find(id)?.Title</strong>}</li>}</ol><button class="primary" @onclick="ApplyAssist">@T("Aprobar y aplicar plan","Approve and apply plan")</button>}</dialog>
<dialog id="import-dialog" aria-labelledby="import-title">
@if(importPreview is {} preview){<h2 id="import-title">@T("Revisar importación","Review import")</h2><p>@T("Formato validado. No se guardó ningún cambio.","Format validated. No changes saved.")</p><p>@preview.NewTemplates @T("nuevas","new") · @preview.Duplicates @T("duplicadas","duplicates") · @preview.Conflicts @T("conflictos","conflicts")</p><p class="hint">@(preview.Restore?T("Restaurar reemplazará todos los datos, asociaciones, versiones e historial.","Restore will replace all data, memberships, versions and history."):T("La importación es aditiva. Duplicados y conflictos de identidad se omiten; el catálogo existente se conserva. Los respaldos completos también pueden contener grupos e historial.","Import is additive. Duplicates and identity conflicts are skipped; the existing catalog is preserved. Full backups may also contain groups and history."))</p><ul class="import-preview-list">@foreach(var row in preview.Items.Take(100)){<li><strong>@row.Title</strong> · @row.Variables variables · @(row.Status switch{"new"=>T("Nueva","New"),"duplicate"=>T("Duplicada","Duplicate"),_=>T("Conflicto","Conflict")})</li>}</ul>@if(preview.Items.Count>100){<p>@T("Se muestran las primeras 100 plantillas.","Showing first 100 templates.")</p>}@if(importError!=""){<p class="notice error" role="alert">@importError</p>}<div class="action-row"><button class="primary" @onclick="ApplyImport">@T("Confirmar importación","Confirm import")</button><button @onclick="CancelImport">@T("Cancelar importación","Cancel import")</button></div>}
</dialog>
<dialog id="proposal-dialog" aria-labelledby="proposal-title">@if(proposal is not null){<h2 id="proposal-title">@T("Revisa la propuesta", "Review the proposal")</h2><p>@proposal.Model · @T("No se aplicaron cambios", "No changes applied")</p>@if(proposalError!=""){<p class="notice error proposal-error" role="alert">@proposalError</p>}<div class="comparison"><section><h3>@T("Original", "Original")</h3><pre>@proposalOriginal</pre></section><section><h3>@T("Propuesta IA", "AI proposal")</h3><pre>@foreach(var line in proposal.Text.Split('\n')){<span class="diff-line @(proposalOriginal.Split('\n').Contains(line)?"":"added")">@line@("\n")</span>}</pre></section></div><h3>@T("Razones / cambios / advertencias del modelo", "Model reasons / changes / warnings")</h3><ul>@foreach(var note in proposal.Reasons.Concat(proposal.Changes).Concat(proposal.Warnings)){<li>@note</li>}</ul><div class="action-row"><button class="primary" @onclick="AcceptProposal">@T("Aceptar propuesta", "Accept proposal")</button><button @onclick="RejectProposal">@T("Rechazar", "Reject")</button></div>}</dialog>

</OverlayHost>
