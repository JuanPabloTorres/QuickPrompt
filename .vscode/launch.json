{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NOVA: depurar agente en base sintética",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "NOVA: preparar depuración sintética",
      "program": "${workspaceFolder}/.playwright/nova-debug/api/QuickPrompt.Api.dll",
      "cwd": "${workspaceFolder}",
      "args": [
        "--QuickPrompt:Port=5260",
        "--QuickPrompt:DataPath=${workspaceFolder}/.playwright/nova-debug/synthetic.sqlite",
        "--QuickPrompt:WebRoot=${workspaceFolder}/.playwright/nova-debug/web",
        "--QuickPrompt:Agent:Runtime=adaptive-core",
        "--QuickPrompt:AdaptiveCore:Python=${env:USERPROFILE}/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe",
        "--QuickPrompt:AdaptiveCore:SdkRoot=${workspaceFolder}/../Adaptive-AI-Core",
        "--QuickPrompt:AdaptiveCore:Worker=${workspaceFolder}/agents/nova-core/nova_worker.py",
        "--QuickPrompt:Diagnostics:DebugPoints=true"
      ],
      "env": { "NOVA_DEBUG_BREAK_ON_FAILURE": "1" },
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(http://127\\.0\\.0\\.1:5260)"
      }
    }
  ]
}
